{
  "name": "@kompakkt/common",
  "version": "0.0.1",
  "description": "Shared types, interfaces, enums and typeguards for Kompakkt",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun check",
    "postinstall": "bun run generate-enums.ts"
  },
  "exports": {
    ".": "./index.ts",
    "./interfaces": "./interfaces.ts",
    "./enums": "./enums.ts",
    "./typeguards": "./typeguards.ts",
    "./helper": "./helper.ts",
    "./wikibase": "./wikibase/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kompakkt/Common.git"
  },
  "license": "AGPL-3.0",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxlint-tsgolint": "^0.20.0"
  },
  "dependencies": {
    "elysia": "^1.4.28"
  }
}
